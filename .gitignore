# ---- Secrets (never commit) ----
setup-deepseek.sh
setup-deepseek.sh.save
.env
.env.*

# ---- Data and weights (GB-scale; excluded by extension, so nested
#      source packages named data/ or utils/ are NOT affected) ----
*.npy
*.npz
*.pkl
*.h5
*.pt
*.pth
*.ckpt
# NOTE: no blanket *.csv rule, so small result tables under results/ stay
# trackable. Training logs live outside this repository.

# ---- Experiment output directories ----
# Anchored to the repo root ("/") so they cannot swallow source packages
# such as v6_multitask/data/.
/data_raw/
/data_v7/
/weights/
/checkpoints/
/output/
/output*/
/runs/
/logs/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
